generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  queued
  toy
  story
  hero
  pages
  pdf
  done
  failed
}

model Book {
  id              String          @id @default(cuid(2))
  status          BookStatus      @default(queued)
  progress        Int             @default(0)
  /// The child profile the parent submitted (ChildProfile in @fabulka/shared).
  child           Json
  language        String
  /// Story method slug (Methodology.slug).
  methodology     String          @default("adventure-quest")
  /// What the parent asked the book to be about, if anything.
  theme           String?
  template        BookTemplate?   @relation("TemplateBooks", fields: [templateId], references: [id], onDelete: SetNull)
  templateId      String?
  /// Answers to the catalog book's questions, by question key.
  answers         Json?
  title           String?
  heroDescription String?
  /// Muse Image response id of the hero character sheet; pages chain from it.
  heroResponseId  String?
  heroImagePath   String?
  /// The favourite toy: the parent's photo, SAM's cut-out, Spark's description, its character sheet.
  toyName         String?
  toyPhotoPath    String?
  toyCutoutPath   String?
  toyDescription  String?
  toyImagePath    String?
  petImagePath    String?
  /// BookPage[]: { page, text, scenePrompt, imagePath }
  pages           Json            @default("[]")
  /// Questions for the parent to ask after reading (dialogic reading).
  talkQuestions   Json            @default("[]")
  /// BookLayout (@fabulka/shared): format, theme snapshot, blocks, page layouts, render QA.
  /// Null for books made before themes: they render in the classic look.
  layout          Json?
  pdfPath         String?
  error           String?
  /// Model spend for this book, in US dollars.
  costUsd         Float           @default(0)
  /// Anonymous visitor key the free limit is counted against.
  clientKey       String
  /// The signed-in parent's account; anonymous books move here when they sign in.
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  /// Set when the book was made with a demo code: it does not count against the visitor.
  demo            Boolean         @default(false)
  /// Visitor's country (ISO code) when blocking by country is on; shows demand in the admin.
  country         String?
  orders          Order[]
  printInterest   PrintInterest[]
  /// Every request to the models made for this book (the journal in the admin).
  modelCalls      ModelCall[]
  /// The catalog book this one is the sample of (in its language), if the admin picked it.
  sampleOf        TemplateSample?
  /// The home page example this book is the version of (in its language), if staff made it one.
  exampleOf       ExampleVersion?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clientKey])
  @@index([userId])
  @@index([createdAt, demo])
}

/// A parent who signed in with Keycloak. Only the Keycloak subject is kept here: the email and
/// name stay in Keycloak (and in the signed session cookie), children's data stays in Book.
model User {
  id        String   @id @default(cuid())
  sub       String   @unique
  books     Book[]
  orders    Order[]
  createdAt DateTime @default(now())
}

/// Books a visitor bought on top of the free ones, priced and paid in their country's currency when
/// bought (a snapshot: later price or rate changes never touch it). Only paid ones add books.
model Credit {
  id              String   @id @default(cuid())
  clientKey       String
  books           Int
  /// The kind of book it was priced as (BOOK_KINDS); null for purchases made before kinds were kept.
  kind            String?
  /// ISO 4217 code of the amounts below.
  currency        String
  /// The price of one book, in the currency's minor units.
  unitAmount      Int
  /// What was charged: unitAmount × books, in minor units.
  amount          Int
  /// US dollars for one unit of `currency` when bought (reports only; never used to charge); null when no rate was known.
  fxToUsd         Decimal? @db.Decimal(24, 12)
  /// PAYMENT_PROVIDERS; "manual" is the demo: nothing is charged and it is paid at once.
  paymentProvider String   @default("manual")
  /// The provider's payment id.
  paymentId       String?
  /// PAYMENT_STATUSES.
  paymentStatus   String   @default("paid")
  createdAt       DateTime @default(now())

  @@index([clientKey])
  @@index([paymentId])
}

enum Cover {
  soft
  hard
}

/// A printed copy of a book (demo payment; the delivery timeline is simulated).
model Order {
  id                   String             @id @default(cuid(2))
  book                 Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId               String
  recipientName        String
  phone                String
  /// Where the confirmation and status emails go.
  email                String
  /// Language of those emails (ru, kk, en); the book's language when not set.
  locale               String?
  /// The city's Russian name when ordered (kept even if the owner renames or removes the city).
  city                 String
  /// The city's id in reference.cities; null for orders made before cities had ids.
  cityId               String?
  address              String
  cover                Cover
  /// The book's layout when ordered (BookLayout in @fabulka/shared): what is printed.
  layout               Json?
  quantity             Int
  /// ISO 4217 code every amount of the order is in: its country's currency when ordered.
  currency             String
  /// The lines' total, in minor units.
  itemsAmount          Int
  /// The delivery fee charged, in minor units (0 when free).
  deliveryAmount       Int
  /// What was charged: itemsAmount + deliveryAmount, in minor units.
  totalAmount          Int
  /// US dollars for one unit of `currency` when ordered (reports only; never used to charge); null when no rate was known.
  fxToUsd              Decimal?           @db.Decimal(24, 12)
  /// The print partner's delivery cost when ordered (any currency; for margins), null when not set.
  deliveryCost         Int?
  deliveryCostCurrency String?
  deliveryCostFxToUsd  Decimal?           @db.Decimal(24, 12)
  /// PAYMENT_PROVIDERS; "manual" is the demo: nothing is charged and it is paid at once.
  paymentProvider      String             @default("manual")
  paymentId            String?
  /// PAYMENT_STATUSES.
  paymentStatus        String             @default("paid")
  /// What was ordered and at what price, frozen when ordered.
  lines                OrderLine[]
  /// Set by hand in the admin (ORDER_STATUSES); until then the stage follows the demo timer.
  status               String?
  /// Anonymous visitor key the order was placed with; it moves to the account on sign-in.
  clientKey            String
  /// The signed-in parent's account (set when ordered signed in, or on sign-in later).
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId               String?
  /// Stages the order reached and when (written on create and on each change in the admin).
  events               OrderStatusEvent[]
  /// The country it was ordered from (ISO code); null when not known (only global staff see it).
  country              String?
  createdAt            DateTime           @default(now())

  @@index([bookId])
  @@index([country])
  @@index([clientKey])
  @@index([userId])
  @@index([paymentId])
}

/// One line of an order as priced when ordered: a book in a format and cover, how many, the price of
/// one and of all (in the order's currency), and the print partner's cost per copy when it was set.
model OrderLine {
  id           String   @id @default(cuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  /// Its place in the order.
  position     Int      @default(0)
  bookId       String
  /// The format's id; null for orders made before formats.
  format       String?
  cover        Cover
  quantity     Int
  /// One copy, in minor units of the order's currency.
  unitAmount   Int
  /// unitAmount × quantity.
  lineAmount   Int
  /// The print partner's cost of one copy when ordered (any currency), null when not set.
  unitCost     Int?
  costCurrency String?
  costFxToUsd  Decimal? @db.Decimal(24, 12)

  @@index([orderId])
}

/// A rate to US dollars for one day (reports only: approximate dollar totals; nothing is charged at
/// a converted price). Fetched daily from public sources; a superadmin's override is a "manual" row.
model FxRate {
  id        String   @id @default(cuid())
  /// The day the rate is for.
  date      DateTime @db.Date
  /// ISO 4217 code.
  currency  String
  /// US dollars for one unit of the currency.
  rateToUsd Decimal  @db.Decimal(24, 12)
  /// FX_SOURCES: ecb, nbk or manual.
  source    String
  /// Who set a manual rate (an email).
  setBy     String?
  createdAt DateTime @default(now())

  @@unique([date, currency, source])
  @@index([currency, date])
}

/// One stage an order reached (ORDER_STATUSES) and when.
model OrderStatusEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  /// What the admin wrote along with the change, if anything.
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Service-wide switches changed in the admin, such as pausing generation.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A catalog book: a plot written by an author that each child's story is adapted from.
model BookTemplate {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  summary       String
  ageMin        Int
  ageMax        Int
  /// Story method slug (Methodology.slug).
  methodology   String
  languages     String[]
  /// What the book is about, in English, for Muse Spark.
  theme         String
  /// Plot points in order, in English; Muse Spark spreads them across the pages.
  plot          Json
  /// TemplateQuestion[] (@fabulka/shared).
  questions     Json             @default("[]")
  /// Replaces the default art style in image prompts.
  stylePrompt   String?
  /// Book theme (BOOK_THEMES in @fabulka/shared) its books get; null: by the child's age.
  layoutTheme   String?
  /// Blocks its books get and the optional ones parents may add (TemplateBlocks in @fabulka/shared);
  /// null: the default blocks.
  blocks        Json?
  coverUrl      String?
  /// Kazakh and English text by language: TemplateTranslation in @fabulka/shared.
  translations  Json             @default("{}")
  published     Boolean          @default(true)
  sortOrder     Int              @default(0)
  /// Country codes (reference.countries) where the catalog lists it (include), or leaves it out
  /// (exclude); empty: everywhere. Its page opens from anywhere by a direct link.
  countries     String[]         @default([])
  countriesMode CountriesMode    @default(include)
  books         Book[]           @relation("TemplateBooks")
  /// Finished books made from this template, shown on its page as examples: one per language.
  samples       TemplateSample[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// A catalog book's example in one language, globally or for one country: a finished book made from
/// it in that language. A book is the sample of one catalog book at most; deleting either removes
/// the row.
model TemplateSample {
  template   BookTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  /// The book's language (Language in @fabulka/shared).
  language   String
  /// The country whose visitors see it before the global one (ISO code); "" for the global sample.
  country    String       @default("")
  book       Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String       @unique
  createdAt  DateTime     @default(now())

  @@id([templateId, language, country])
}

/// Where something is shown: only in its countries (include), or everywhere but them (exclude).
enum CountriesMode {
  include
  exclude
}

/// A story on the home page's examples, in one or more languages (admin «Examples»). The home page
/// shows, for each example listed in the visitor's country, its version in exactly the page's
/// language. Deleting an example keeps its books.
model Example {
  id            String           @id @default(cuid())
  /// Country codes (reference.countries) where it is shown (include) or not (exclude); empty: as its
  /// catalog book's countries say, or everywhere for a story of its own (showcaseRule in @fabulka/shared).
  countries     String[]         @default([])
  countriesMode CountriesMode    @default(include)
  /// Ascending: the order of the home page.
  sortOrder     Int              @default(0)
  versions      ExampleVersion[]
  createdAt     DateTime         @default(now())

  @@index([sortOrder])
}

/// An example in one language: a book in that language (finished, or being translated from another
/// version). A book is the version of one example at most; deleting either removes the row.
model ExampleVersion {
  example   Example  @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  exampleId String
  /// The book's language (Language in @fabulka/shared).
  language  String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String   @unique
  createdAt DateTime @default(now())

  @@id([exampleId, language])
}

/// A story method a book follows, edited in the admin; seeded from DEFAULT_METHODOLOGIES in
/// @fabulka/shared. Books and catalog books refer to it by slug (no foreign key: the slug is checked
/// when a book is made, and a method that is in use cannot be deleted, only unpublished).
model Methodology {
  slug      String   @id
  /// Name and summary by interface language: { ru, kk, en } of { name, summary }.
  texts     Json
  /// Where the method comes from.
  source    String
  ageMin    Int
  ageMax    Int
  /// Story beats in order (string[], English); Muse Spark spreads the pages across them.
  structure Json
  /// Rules the story keeps (string[], English).
  rules     Json     @default("[]")
  /// What the story avoids (string[], English).
  avoid     Json     @default("[]")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Someone outside Kazakhstan asked for a printed copy: demand for print partners abroad.
model PrintInterest {
  id        String   @id @default(cuid())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  /// Visitor's country (ISO code) when blocking by country is on.
  country   String?
  createdAt DateTime @default(now())

  @@unique([bookId])
}

/// One request to the models (Meta's, or the mock): how long it took, what it cost, how it ended.
/// The prompt and the output are kept only for failed calls, and only for 30 days; the rows for
/// 90 days (JournalCleaner). Children's data can be in the prompt, so only the admin reads it.
model ModelCall {
  id           String   @id @default(cuid())
  /// The book it was made for; voice prefill calls have none.
  book         Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId       String?
  /// MODEL_CALL_KINDS in @fabulka/shared.
  kind         String
  model        String
  /// ok or error.
  status       String
  /// 1 for the first try; our own retries (a story that was not valid JSON) count up.
  attempt      Int      @default(1)
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  /// Images generated or read by an image model (Muse Image, SAM).
  images       Int      @default(0)
  costUsd      Float
  responseId   String?
  errorCode    String?
  errorMessage String?
  prompt       String?
  output       String?
  /// A staff action's call (an example translation, a theme proposal): who started it (their
  /// email) and the country it was for; staff daily caps sum these.
  staffEmail   String?
  staffCountry String?
  createdAt    DateTime @default(now())

  @@index([bookId])
  @@index([createdAt])
  @@index([kind, status, createdAt])
  @@index([staffEmail, createdAt])
  @@index([staffCountry, createdAt])
}

/// An error a visitor saw in the browser (POST /telemetry/error). No client key, IP, names or
/// form values: the message, the page path and the API's error code are enough to find the bug.
model ClientError {
  id        String   @id @default(cuid())
  /// js, api or unhandled (CLIENT_ERROR_KINDS in @fabulka/shared).
  kind      String
  message   String
  path      String
  code      String?
  status    Int?
  locale    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A book theme Muse Spark proposed from the owner's brief (admin «Темы»). Curated themes live in
/// code; these are checked in code (contrast, sizes, glyphs, a sample book in every language through
/// render QA) before they are stored, and become selectable once staff publish them.
model Theme {
  id        String   @id
  /// BookTheme (@fabulka/shared), source "ai".
  theme     Json
  /// What the owner asked for.
  brief     String
  published Boolean  @default(false)
  /// ThemeCheck[] (@fabulka/shared): what was checked and how it went.
  checks    Json     @default("[]")
  /// Sample page PNGs by language: { ru: ["themes/…/ru-0.png", …], … }.
  previews  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

/// SEO of one public page in one language (admin «SEO»). Staff edit the draft; publishing copies it
/// to `published`, which is what the site serves. Null fields (in either) mean the page's default.
/// `page` is a key: home, catalog, create, privacy, terms, template:<slug>, book:<id>.
model PageSeo {
  page        String
  /// The language version (Language in @fabulka/shared): SEO is per language, not per country.
  language    String
  /// SeoFields (@fabulka/shared): title, description, ogImage (a storage path), noindex.
  draft       Json
  /// SeoFields as last published; null until the first publish.
  published   Json?
  publishedAt DateTime?
  /// Who last saved the draft (an email, when known).
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([page, language])
}

/// Every change made in the admin's SEO section: pages, redirects and settings, with who made it
/// and the values before and after. A page's change can be reverted from here.
model SeoHistory {
  id        String   @id @default(cuid())
  /// page, redirect or settings (SEO_HISTORY_KINDS).
  kind      String
  /// `<page key>@<language>` for a page, the redirect's id, or "settings".
  target    String
  /// save, publish, revert, create, update or delete (SEO_HISTORY_ACTIONS).
  action    String
  before    Json?
  after     Json?
  who       String?
  createdAt DateTime @default(now())

  @@index([kind, target, createdAt])
  @@index([createdAt])
}

/// A redirect staff set up in the admin's SEO section, applied by the site's proxy.
model Redirect {
  id        String   @id @default(cuid())
  /// A site path as visitors type it, language prefix included (/de/alt); no query.
  from      String   @unique
  /// A site path or an absolute http(s) URL.
  to        String
  /// 301 (permanent) or 302 (temporary).
  status    Int      @default(301)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// invited: added in Team, has not signed in yet; disabled: no admin, whatever the roles.
enum StaffStatus {
  invited
  active
  disabled
}

/// A member of staff: who may open the admin, with which roles and in which countries (admin «Team»).
/// Keycloak only says who someone is; their rights live here and are read on every admin request.
model StaffMember {
  id          String      @id @default(cuid(2))
  /// Lower-cased; how an invite finds them before their Keycloak user is linked.
  email       String      @unique
  /// The Keycloak user (`sub`), linked on their first sign-in.
  keycloakId  String?     @unique
  name        String      @default("")
  status      StaffStatus @default(invited)
  /// StaffRole keys.
  roles       String[]    @default([])
  /// Country codes (reference.countries) their country-scoped roles hold in.
  countries   String[]    @default([])
  /// Keycloak realm roles seen at their last sign-in (admin, seo); realm `admin` is always a superadmin.
  realmRoles  String[]    @default([])
  lastLoginAt DateTime?
  /// Who invited them (an email), or "keycloak" for a row made from a realm role at sign-in.
  createdBy   String?
  /// Their own daily cap on staff generation in dollars; null: the default (none for a superadmin).
  capUsd      Float?
  /// No cap at all, whatever the defaults.
  uncapped    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// One admin write (the admin's «Activity»): who, which section and action, on what, in which
/// country, and a short summary of the change (AuditSummary in @fabulka/shared; never secrets or a
/// book's contents). Kept for AUDIT_RETENTION_DAYS.
model AuditEvent {
  id           String   @id @default(cuid(2))
  at           DateTime @default(now())
  actorStaffId String?
  actorEmail   String?
  /// Their roles at the time.
  actorRoles   String[] @default([])
  /// A permission key (ADMIN_PERMISSIONS).
  section      String
  /// AUDIT_ACTIONS in @fabulka/shared.
  action       String
  targetType   String?
  targetId     String?
  /// The country the change belongs to; null for global data.
  country      String?
  summary      Json     @default("{}")
  ip           String?
  userAgent    String?

  @@index([at])
  @@index([country, at])
  @@index([actorEmail, at])
  @@index([section, at])
}

/// A role of the admin: the rights it gives (ADMIN_RIGHTS in @fabulka/shared) and whether they hold
/// only in the person's countries. Seeded with admin (locked), seo and country_manager.
model StaffRole {
  key       String   @id
  name      String
  rights    String[] @default([])
  scoped    Boolean  @default(false)
  /// The superadmin role: never edited or deleted.
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

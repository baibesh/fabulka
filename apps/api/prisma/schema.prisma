generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  queued
  toy
  story
  hero
  pages
  pdf
  done
  failed
}

model Book {
  id              String          @id @default(cuid(2))
  status          BookStatus      @default(queued)
  progress        Int             @default(0)
  /// The child profile the parent submitted (ChildProfile in @fabulka/shared).
  child           Json
  language        String
  /// Story method slug (Methodology.slug).
  methodology     String          @default("adventure-quest")
  /// What the parent asked the book to be about, if anything.
  theme           String?
  template        BookTemplate?   @relation("TemplateBooks", fields: [templateId], references: [id], onDelete: SetNull)
  templateId      String?
  /// Answers to the catalog book's questions, by question key.
  answers         Json?
  title           String?
  heroDescription String?
  /// Muse Image response id of the hero character sheet; pages chain from it.
  heroResponseId  String?
  heroImagePath   String?
  /// The favourite toy: the parent's photo, SAM's cut-out, Spark's description, its character sheet.
  toyName         String?
  toyPhotoPath    String?
  toyCutoutPath   String?
  toyDescription  String?
  toyImagePath    String?
  petImagePath    String?
  /// BookPage[]: { page, text, scenePrompt, imagePath }
  pages           Json            @default("[]")
  /// Questions for the parent to ask after reading (dialogic reading).
  talkQuestions   Json            @default("[]")
  /// BookLayout (@fabulka/shared): format, theme snapshot, blocks, page layouts, render QA.
  /// Null for books made before themes: they render in the classic look.
  layout          Json?
  pdfPath         String?
  error           String?
  /// Model spend for this book, in US dollars.
  costUsd         Float           @default(0)
  /// Anonymous visitor key the free limit is counted against.
  clientKey       String
  /// The signed-in parent's account; anonymous books move here when they sign in.
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  /// Set when the book was made with a demo code: it does not count against the visitor.
  demo            Boolean         @default(false)
  /// Visitor's country (ISO code) when blocking by country is on; shows demand in the admin.
  country         String?
  /// Picked in the admin to show every visitor on the home page as an example (done books only).
  featured        Boolean         @default(false)
  orders          Order[]
  printInterest   PrintInterest[]
  /// Every request to the models made for this book (the journal in the admin).
  modelCalls      ModelCall[]
  /// The catalog book this one is the sample of (in its language), if the admin picked it.
  sampleOf        TemplateSample?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clientKey])
  @@index([userId])
  @@index([createdAt, demo])
  @@index([featured, createdAt])
}

/// A parent who signed in with Keycloak. Only the Keycloak subject is kept here: the email and
/// name stay in Keycloak (and in the signed session cookie), children's data stays in Book.
model User {
  id        String   @id @default(cuid())
  sub       String   @unique
  books     Book[]
  orders    Order[]
  createdAt DateTime @default(now())
}

/// Books a visitor bought on top of the free ones (demo payment: nothing is charged).
model Credit {
  id        String   @id @default(cuid())
  clientKey String
  books     Int
  /// What it cost in tenge; 0 when bought in dollars.
  priceKzt  Int
  /// What it cost in dollars (a country priced in USD); 0 when bought in tenge.
  priceUsd  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([clientKey])
}

enum Cover {
  soft
  hard
}

/// A printed copy of a book (demo payment; the delivery timeline is simulated).
model Order {
  id            String             @id @default(cuid(2))
  book          Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId        String
  recipientName String
  phone         String
  /// Where the confirmation and status emails go.
  email         String
  /// Language of those emails (ru, kk, en); the book's language when not set.
  locale        String?
  /// The city's Russian name when ordered (kept even if the owner renames or removes the city).
  city          String
  /// The city's id in reference.cities; null for orders made before cities had ids.
  cityId        String?
  address       String
  cover         Cover
  /// The book's layout when ordered (BookLayout in @fabulka/shared): what is printed.
  layout        Json?
  quantity      Int
  booksKzt      Int
  deliveryKzt   Int
  totalKzt      Int
  /// Set by hand in the admin (ORDER_STATUSES); until then the stage follows the demo timer.
  status        String?
  /// Anonymous visitor key the order was placed with; it moves to the account on sign-in.
  clientKey     String
  /// The signed-in parent's account (set when ordered signed in, or on sign-in later).
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  /// Stages the order reached and when (written on create and on each change in the admin).
  events        OrderStatusEvent[]
  createdAt     DateTime           @default(now())

  @@index([bookId])
  @@index([clientKey])
  @@index([userId])
}

/// One stage an order reached (ORDER_STATUSES) and when.
model OrderStatusEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  /// What the admin wrote along with the change, if anything.
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Service-wide switches changed in the admin, such as pausing generation.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A catalog book: a plot written by an author that each child's story is adapted from.
model BookTemplate {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  summary      String
  ageMin       Int
  ageMax       Int
  /// Story method slug (Methodology.slug).
  methodology  String
  languages    String[]
  /// What the book is about, in English, for Muse Spark.
  theme        String
  /// Plot points in order, in English; Muse Spark spreads them across the pages.
  plot         Json
  /// TemplateQuestion[] (@fabulka/shared).
  questions    Json     @default("[]")
  /// Replaces the default art style in image prompts.
  stylePrompt  String?
  /// Book theme (BOOK_THEMES in @fabulka/shared) its books get; null: by the child's age.
  layoutTheme  String?
  /// Blocks its books get and the optional ones parents may add (TemplateBlocks in @fabulka/shared);
  /// null: the default blocks.
  blocks       Json?
  coverUrl     String?
  /// Kazakh and English text by language: TemplateTranslation in @fabulka/shared.
  translations Json     @default("{}")
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  /// Country codes (reference.countries) where the catalog lists it; empty: everywhere. Its page
  /// opens from anywhere by a direct link.
  countries    String[] @default([])
  books        Book[]   @relation("TemplateBooks")
  /// Finished books made from this template, shown on its page as examples: one per language.
  samples      TemplateSample[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A catalog book's example in one language: a finished book made from it in that language. A book
/// is the sample of one catalog book at most; deleting either removes the row.
model TemplateSample {
  template   BookTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  /// The book's language (Language in @fabulka/shared).
  language   String
  book       Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String       @unique
  createdAt  DateTime     @default(now())

  @@id([templateId, language])
}

/// A story method a book follows, edited in the admin; seeded from DEFAULT_METHODOLOGIES in
/// @fabulka/shared. Books and catalog books refer to it by slug (no foreign key: the slug is checked
/// when a book is made, and a method that is in use cannot be deleted, only unpublished).
model Methodology {
  slug      String   @id
  /// Name and summary by interface language: { ru, kk, en } of { name, summary }.
  texts     Json
  /// Where the method comes from.
  source    String
  ageMin    Int
  ageMax    Int
  /// Story beats in order (string[], English); Muse Spark spreads the pages across them.
  structure Json
  /// Rules the story keeps (string[], English).
  rules     Json     @default("[]")
  /// What the story avoids (string[], English).
  avoid     Json     @default("[]")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Someone outside Kazakhstan asked for a printed copy: demand for print partners abroad.
model PrintInterest {
  id        String   @id @default(cuid())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  /// Visitor's country (ISO code) when blocking by country is on.
  country   String?
  createdAt DateTime @default(now())

  @@unique([bookId])
}

/// One request to the models (Meta's, or the mock): how long it took, what it cost, how it ended.
/// The prompt and the output are kept only for failed calls, and only for 30 days; the rows for
/// 90 days (JournalCleaner). Children's data can be in the prompt, so only the admin reads it.
model ModelCall {
  id           String   @id @default(cuid())
  /// The book it was made for; voice prefill calls have none.
  book         Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId       String?
  /// MODEL_CALL_KINDS in @fabulka/shared.
  kind         String
  model        String
  /// ok or error.
  status       String
  /// 1 for the first try; our own retries (a story that was not valid JSON) count up.
  attempt      Int      @default(1)
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  /// Images generated or read by an image model (Muse Image, SAM).
  images       Int      @default(0)
  costUsd      Float
  responseId   String?
  errorCode    String?
  errorMessage String?
  prompt       String?
  output       String?
  createdAt    DateTime @default(now())

  @@index([bookId])
  @@index([createdAt])
  @@index([kind, status, createdAt])
}

/// An error a visitor saw in the browser (POST /telemetry/error). No client key, IP, names or
/// form values: the message, the page path and the API's error code are enough to find the bug.
model ClientError {
  id        String   @id @default(cuid())
  /// js, api or unhandled (CLIENT_ERROR_KINDS in @fabulka/shared).
  kind      String
  message   String
  path      String
  code      String?
  status    Int?
  locale    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A book theme Muse Spark proposed from the owner's brief (admin «Темы»). Curated themes live in
/// code; these are checked in code (contrast, sizes, glyphs, a sample book in every language through
/// render QA) before they are stored, and become selectable once staff publish them.
model Theme {
  id        String   @id
  /// BookTheme (@fabulka/shared), source "ai".
  theme     Json
  /// What the owner asked for.
  brief     String
  published Boolean  @default(false)
  /// ThemeCheck[] (@fabulka/shared): what was checked and how it went.
  checks    Json     @default("[]")
  /// Sample page PNGs by language: { ru: ["themes/…/ru-0.png", …], … }.
  previews  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}
